<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="#FFFFFF"
    android:layout_marginBottom="16dp">

    <!-- AI % badge -->
    <TextView
        android:id="@+id/tvAiPercent"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:gravity="center"
        android:text="AI 99%"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:background="@drawable/ai_percent_bg"
        android:layout_gravity="end"/>

    <!-- Bike image -->
    <ImageView
        android:id="@+id/imgBike"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_marginTop="8dp"
        android:scaleType="fitCenter"
        android:src="@drawable/bike1"/>

    <!-- Bike name -->
    <TextView
        android:id="@+id/tvBikeName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Honda SP 125"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginTop="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Avg Ex-showroom price"
        android:textSize="12sp"
        android:textColor="#777777"/>

    <!-- Price -->
    <TextView
        android:id="@+id/tvPrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="₹ 86,423 Onwards"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginTop="4dp"/>

    <!-- View details -->
    <TextView
        android:id="@+id/btnViewDetails"
        android:layout_width="140dp"
        android:layout_height="40dp"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="view details"
        android:textColor="#FFFFFF"
        android:background="@drawable/rounded_btn_green"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="#DDDDDD"/>

</LinearLayout>
