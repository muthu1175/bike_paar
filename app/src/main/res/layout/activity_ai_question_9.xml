<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F4F4"
    android:fitsSystemWindows="true">

    <!-- TOP BAR -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@android:color/white">

        <ImageView
            android:id="@+id/ivMenu_q9"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="16dp"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_menu" />

        <ImageView
            android:id="@+id/ivLogo_q9"
            android:layout_width="520dp"
            android:layout_height="324dp"
            android:layout_centerInParent="true"
            android:src="@drawable/bikepaar_logo" />

        <ImageView
            android:id="@+id/ivBell_q9"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginEnd="16dp"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            android:src="@drawable/ic_notifications" />
    </RelativeLayout>

    <!-- FULL BLUE CARD -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="66dp"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="24dp"
        android:background="@drawable/ai_card_bg">

        <!-- header row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AI Suggestion"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

            <TextView
                android:id="@+id/tvStep_q9"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="9/9"
                android:textColor="#FFFFFF" />

            <ImageView
                android:id="@+id/btnClose_q9"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="12dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:tint="#FFFFFF" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressBar_q9"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="8dp"
            android:progress="9"
            android:max="9"
            android:progressTint="#27AE60"
            android:backgroundTint="#DDDDDD" />

        <!-- big icon -->
        <ImageView
            android:id="@+id/ic_experience_big"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_marginTop="28dp"
            android:layout_gravity="center_horizontal"
            android:src="@drawable/ic_experience_big" />

        <!-- title -->
        <TextView
            android:id="@+id/tvTitle_q9"
            android:layout_marginTop="20dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Riding experience?"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_gravity="center_horizontal" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Years of driving skill"
            android:textColor="#BFE0FF"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"/>

        <!-- options -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="18dp">

            <RelativeLayout
                android:id="@+id/optBeginner_q9"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:padding="12dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/option_selected_bg">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:src="@drawable/ic_beginner"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Beginner"
                    android:textColor="#222222"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:layout_toEndOf="@id/optBeginner_q9"
                    android:layout_marginStart="64dp"
                    android:layout_alignParentTop="true" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0-2 years"
                    android:textColor="#666666"
                    android:textSize="12sp"
                    android:layout_toEndOf="@id/optBeginner_q9"
                    android:layout_marginStart="64dp"
                    android:layout_below="@id/optBeginner_q9"
                    android:layout_marginTop="28dp" />

                <ImageView
                    android:id="@+id/ivBeginnerTick_q9"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_radio_selected" />
            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/optIntermediate_q9"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:padding="12dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/option_bg">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:src="@drawable/ic_intermediate"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Intermediate"
                    android:textColor="#222222"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:layout_toEndOf="@id/optIntermediate_q9"
                    android:layout_marginStart="64dp"
                    android:layout_alignParentTop="true" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2-5 years"
                    android:textColor="#666666"
                    android:textSize="12sp"
                    android:layout_toEndOf="@id/optIntermediate_q9"
                    android:layout_marginStart="64dp"
                    android:layout_below="@id/optIntermediate_q9"
                    android:layout_marginTop="28dp" />

                <ImageView
                    android:id="@+id/ivIntermediateTick_q9"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_radio_unselected"
                    android:visibility="invisible" />
            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/optExpert_q9"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:padding="12dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/option_bg">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:src="@drawable/ic_expert"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Expert"
                    android:textColor="#222222"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:layout_toEndOf="@id/optExpert_q9"
                    android:layout_marginStart="64dp"
                    android:layout_alignParentTop="true" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5+ years"
                    android:textColor="#666666"
                    android:textSize="12sp"
                    android:layout_toEndOf="@id/optExpert_q9"
                    android:layout_marginStart="64dp"
                    android:layout_below="@id/optExpert_q9"
                    android:layout_marginTop="28dp" />

                <ImageView
                    android:id="@+id/ivExpertTick_q9"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_radio_unselected"
                    android:visibility="invisible" />
            </RelativeLayout>
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>

        <!-- BACK + AI suggest buttons: BACK added so java can bind -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginTop="12dp">

            <TextView
                android:id="@+id/btnBack_q9"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="back"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/ai_prev_button_bg" />

            <TextView
                android:id="@+id/btnAiSuggest_q9"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="AI suggest"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:background="@drawable/ai_next_button_bg" />
        </LinearLayout>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
