<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardUseCompatPadding="true">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        android:padding="8dp">

        <!-- Bike Image -->
        <RelativeLayout
            android:id="@+id/imageContainer"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:background="#F1F5F9"
            android:padding="8dp">

            <ImageView
                android:id="@+id/bikeImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop" />

            <!-- Favorite Button -->
            <ImageView
                android:id="@+id/favIcon"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_alignParentTop="true"
                android:layout_alignParentEnd="true"
                android:background="@drawable/circle_bg"
                android:padding="8dp"
                android:src="@drawable/ic_favorite_border"
                android:tint="#9CA3AF" />

            <!-- Bestseller Badge -->
            <TextView
                android:id="@+id/bestsellerBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_alignParentStart="true"
                android:background="#FF4D4D"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:text="BESTSELLER"
                android:textColor="@android:color/white"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone" />

        </RelativeLayout>

        <!-- Details -->
        <LinearLayout
            android:id="@+id/detailsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/imageContainer"
            android:orientation="vertical"
            android:paddingTop="8dp">

            <!-- Brand -->
            <TextView
                android:id="@+id/brandName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="YAMAHA"
                android:textColor="#1E3A8A"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <!-- Bike Name -->
            <TextView
                android:id="@+id/bikeName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="YZF R15 V4"
                android:textColor="#1F2937"
                android:textSize="16sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <!-- CC and Type -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/ccText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#F3F4F6"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:text="155cc"
                    android:textColor="#4B5563"
                    android:textSize="10sp"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/typeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:background="#F3F4F6"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:text="Sports"
                    android:textColor="#4B5563"
                    android:textSize="10sp"
                    android:gravity="center" />

            </LinearLayout>

            <!-- Price -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ex-Showroom"
                    android:textColor="#9CA3AF"
                    android:textSize="10sp"
                    android:textStyle="normal" />

                <TextView
                    android:id="@+id/priceText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₹ 1.82 Lakh"
                    android:textColor="#1F2937"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

        <!-- View Details Button -->
        <Button
            android:id="@+id/viewDetailsButton"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_below="@id/detailsContainer"
            android:layout_marginTop="12dp"
            android:text="View Details"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="@drawable/view_details_button_bg" />

    </RelativeLayout>

</androidx.cardview.widget.CardView>