<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    card:cardElevation="4dp"
    android:layout_marginBottom="12dp"
    card:cardCornerRadius="8dp"
    android:padding="12dp"
    android:background="@android:color/white">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/ivBikeImage"
            android:layout_width="140dp"
            android:layout_height="90dp"
            android:scaleType="centerInside"
            android:src="@drawable/sample_bike"
            android:contentDescription="bike image" />

        <TextView
            android:id="@+id/tvBikeName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/ivBikeImage"
            android:layout_marginStart="12dp"
            android:text="Bike Name"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#222222" />

        <TextView
            android:id="@+id/tvBikeSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/ivBikeImage"
            android:layout_below="@id/tvBikeName"
            android:layout_marginStart="12dp"
            android:text="Avg Ex-showroom price"
            android:textSize="12sp"
            android:textColor="#666666" />

        <TextView
            android:id="@+id/tvBikePrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/ivBikeImage"
            android:layout_below="@id/tvBikeSubtitle"
            android:layout_marginStart="12dp"
            android:text="₹ 86,423"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#000000" />

        <TextView
            android:id="@+id/tvAiBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="8dp"
            android:text="AI 99%"
            android:textColor="#FFFFFF"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:background="@drawable/ai_percentage_badge"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnViewDetails"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_below="@id/ivBikeImage"
            android:layout_marginTop="10dp"
            android:text="view details"
            android:layout_alignParentStart="true"
            android:backgroundTint="#1DBF9E"
            android:textColor="#FFFFFF" />

    </RelativeLayout>
</androidx.cardview.widget.CardView>
