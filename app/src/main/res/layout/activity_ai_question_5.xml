<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F4F4"
    android:fitsSystemWindows="true">

    <!-- TOP BAR -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@android:color/white">

        <ImageView
            android:id="@+id/ivMenu_q5"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="16dp"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_menu" />

        <ImageView
            android:id="@+id/ivLogo_q5"
            android:layout_width="520dp"
            android:layout_height="324dp"
            android:layout_centerInParent="true"
            android:src="@drawable/bikepaar_logo" />

        <ImageView
            android:id="@+id/ivBell_q5"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginEnd="16dp"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            android:src="@drawable/ic_notifications" />
    </RelativeLayout>

    <!-- BLUE CARD (full-screen) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="66dp"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingTop="14dp"
        android:paddingBottom="20dp"
        android:background="@drawable/ai_card_bg">

        <!-- header row -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvAiLabel_q5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AI Suggestion"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="14sp"
                android:layout_alignParentStart="true" />

            <TextView
                android:id="@+id/tvStep_q5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5/9"
                android:textColor="#FFFFFF"
                android:layout_alignParentEnd="true"
                android:layout_marginEnd="36dp" />

            <ProgressBar
                android:id="@+id/progressBar_q5"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_below="@id/tvAiLabel_q5"
                android:layout_marginTop="8dp"
                android:max="9"
                android:progress="5"
                android:progressTint="#27AE60"
                android:backgroundTint="#2B3A6A" />

            <ImageView
                android:id="@+id/btnClose_q5"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:tint="#FFFFFF"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="2dp"/>
        </RelativeLayout>

        <!-- big icon -->
        <ImageView
            android:id="@+id/ic_distance_big"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_marginTop="8dp"
            android:layout_gravity="center_horizontal"
            android:src="@drawable/ic_distance_big" />

        <!-- title -->
        <TextView
            android:id="@+id/tvTitle_q5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Daily riding distance?"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginTop="12dp"
            android:layout_gravity="center_horizontal"/>

        <TextView
            android:id="@+id/tvSub_q5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="how far do you ride daily?"
            android:textSize="12sp"
            android:textColor="#BFE0FF"
            android:layout_marginTop="6dp"
            android:layout_gravity="center_horizontal"/>

        <!-- Seekbar section (REPLACE existing SeekBar block with this) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:paddingLeft="6dp"
            android:paddingRight="6dp">

            <!-- popup that will follow the thumb -->
            <TextView
                android:id="@+id/tvThumbPopup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:background="@drawable/thumb_popup_bg"
                android:text="30 km"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="12sp"
                android:visibility="visible"
                android:layout_marginBottom="6dp"
                android:translationY="-28dp" />

            <SeekBar
                android:id="@+id/seekDistance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="250"
                android:progress="30"
                android:splitTrack="false" />
        </FrameLayout>

        <!-- min / current / max row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="6dp">

            <TextView
                android:id="@+id/tvMin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="30"
                android:textColor="#FFFFFF" />

            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>

            <TextView
                android:id="@+id/tvCurrentDistance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="30 km"
                android:textColor="#FFFFFF"
                android:textStyle="bold"/>

            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>

            <TextView
                android:id="@+id/tvMax"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="250"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>

        <!-- navigation -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <TextView
                android:id="@+id/btnBack_q5"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:gravity="center"
                android:text="back"
                android:textColor="#FFFFFF"
                android:background="@drawable/ai_prev_button_bg"/>

            <TextView
                android:id="@+id/btnNext_q5"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:gravity="center"
                android:text="next  →"
                android:textColor="#FFFFFF"
                android:background="@drawable/ai_next_button_bg"/>
        </LinearLayout>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
