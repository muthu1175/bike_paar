<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@android:color/white"
    android:padding="16dp"
    android:elevation="2dp"
    android:fitsSystemWindows="true"
    android:clipToPadding="false">

    <!-- Bike Image with Engine Badge -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_marginBottom="12dp"
        android:background="#E5E7EB"
        android:padding="8dp">

        <ImageView
            android:id="@+id/bikeImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop" />

        <!-- Engine Badge -->
        <TextView
            android:id="@+id/engineBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:background="#80000000"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:text="998cc"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:textStyle="bold" />

    </RelativeLayout>

    <!-- Bike Name and Rating -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp">

        <TextView
            android:id="@+id/bikeName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kawasaki Ninja H2"
            android:textColor="#111827"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-condensed" />


    </RelativeLayout>

    <!-- Bike Description -->
    <TextView
        android:id="@+id/bikeDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="Hyper Sport • 2024"
        android:textColor="#6B7280"
        android:textSize="14sp" />

    <!-- Price and Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/bikePrice"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="₹35,00,000"
            android:textColor="#FF4D4D"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/viewDetailsBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#1E3A8A"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:text="View Details"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="14sp" />

    </LinearLayout>

</LinearLayout>