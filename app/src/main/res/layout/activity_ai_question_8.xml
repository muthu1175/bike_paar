<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F4F4"
    android:fitsSystemWindows="true">

    <!-- TOP BAR -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@android:color/white">

        <ImageView
            android:id="@+id/ivMenu_q8"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="16dp"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_menu" />

        <ImageView
            android:id="@+id/ivLogo_q8"
            android:layout_width="520dp"
            android:layout_height="324dp"
            android:layout_centerInParent="true"
            android:src="@drawable/bikepaar_logo" />

        <ImageView
            android:id="@+id/ivBell_q8"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginEnd="16dp"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            android:src="@drawable/ic_notifications" />
    </RelativeLayout>

    <!-- full card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="66dp"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="20dp"
        android:background="@drawable/ai_card_bg">

        <!-- header + progress -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvLabel_q8"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AI Suggestion"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

            <TextView
                android:id="@+id/tvStep_q8"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="8/9"
                android:textColor="#FFFFFF" />

            <ImageView
                android:id="@+id/btnClose_q8"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="12dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:tint="#FFFFFF" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressBar_q8"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="8dp"
            android:progress="8"
            android:max="9"
            android:progressTint="#27AE60"
            android:backgroundTint="#DDDDDD" />

        <!-- big icon -->
        <ImageView
            android:id="@+id/ic_category_big"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_marginTop="28dp"
            android:layout_gravity="center_horizontal"
            android:src="@drawable/ic_category_big" />

        <!-- title -->
        <TextView
            android:id="@+id/tvQuestion_q8"
            android:layout_marginTop="18dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bike category?"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_gravity="center_horizontal" />

        <TextView
            android:id="@+id/tvSub_q8"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="preferred bike style"
            android:textColor="#BFE0FF"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"/>

        <!-- options list -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="18dp">

            <!-- Any Type -->
            <RelativeLayout
                android:id="@+id/optAny"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:padding="10dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/option_selected_bg">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Any Type"
                    android:textColor="#222222"
                    android:textStyle="bold"
                    android:layout_centerVertical="true"
                    android:layout_alignParentStart="true" />

                <ImageView
                    android:id="@+id/ivAnyTick"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_radio_selected"/>
            </RelativeLayout>

            <!-- Sport bike -->
            <RelativeLayout
                android:id="@+id/optSport"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:padding="10dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/option_bg">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sport bike"
                    android:textColor="#222222"
                    android:textStyle="bold"
                    android:layout_centerVertical="true"
                    android:layout_alignParentStart="true" />

                <ImageView
                    android:id="@+id/ivSportTick"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_radio_unselected"
                    android:visibility="invisible"/>
            </RelativeLayout>

            <!-- Cruiser -->
            <RelativeLayout
                android:id="@+id/optCruiser"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:padding="10dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/option_bg">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cruiser"
                    android:textColor="#222222"
                    android:textStyle="bold"
                    android:layout_centerVertical="true"
                    android:layout_alignParentStart="true" />

                <ImageView
                    android:id="@+id/ivCruiserTick"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_radio_unselected"
                    android:visibility="invisible"/>
            </RelativeLayout>

            <!-- Adventure -->
            <RelativeLayout
                android:id="@+id/optAdventure"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:padding="10dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/option_bg">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Adventure"
                    android:textColor="#222222"
                    android:textStyle="bold"
                    android:layout_centerVertical="true"
                    android:layout_alignParentStart="true" />

                <ImageView
                    android:id="@+id/ivAdventureTick"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_radio_unselected"
                    android:visibility="invisible"/>
            </RelativeLayout>

            <!-- Commuter -->
            <RelativeLayout
                android:id="@+id/optCommuter"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:padding="10dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/option_bg">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Commuter"
                    android:textColor="#222222"
                    android:textStyle="bold"
                    android:layout_centerVertical="true"
                    android:layout_alignParentStart="true" />

                <ImageView
                    android:id="@+id/ivCommuterTick"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_radio_unselected"
                    android:visibility="invisible"/>
            </RelativeLayout>

            <!-- Electric -->
            <RelativeLayout
                android:id="@+id/optElectric"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:padding="10dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/option_bg">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Electric"
                    android:textColor="#222222"
                    android:textStyle="bold"
                    android:layout_centerVertical="true"
                    android:layout_alignParentStart="true" />

                <ImageView
                    android:id="@+id/ivElectricTick"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_radio_unselected"
                    android:visibility="invisible"/>
            </RelativeLayout>

        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>

        <!-- buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:weightSum="2">

            <TextView
                android:id="@+id/btnBack_q8"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:gravity="center"
                android:text="back"
                android:textColor="#FFFFFF"
                android:background="@drawable/ai_prev_button_bg"/>

            <TextView
                android:id="@+id/btnNext_q8"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:gravity="center"
                android:text="next  →"
                android:textColor="#FFFFFF"
                android:background="@drawable/ai_next_button_bg"/>
        </LinearLayout>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
