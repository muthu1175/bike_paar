<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.BikePaar" parent="Theme.Material3.Light.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>

    <style name="Theme.BikePaar" parent="Base.Theme.BikePaar">
        <item name="android:windowAnimationStyle">@style/Animation.BikePaar</item>
    </style>

    <style name="Theme.Auth" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:fontFamily">@font/nexa_slab</item>
        <item name="fontFamily">@font/nexa_slab</item>
    </style>

    <style name="Theme.SplashScreen" parent="Theme.AppCompat.Light.NoActionBar">
        <!-- Background color shown BEFORE your layout loads -->
        <item name="android:windowBackground">@color/white</item>
        <!-- No action bar -->
        <item name="windowNoTitle">true</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="Animation.BikePaar" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/fade_in</item>
        <item name="android:activityOpenExitAnimation">@anim/fade_out</item>
        <item name="android:activityCloseEnterAnimation">@anim/fade_in</item>
        <item name="android:activityCloseExitAnimation">@anim/fade_out</item>
    </style>

</resources>