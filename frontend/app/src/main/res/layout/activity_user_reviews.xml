<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#f8f9fa"
    android:fitsSystemWindows="true"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@android:color/white"
            android:paddingHorizontal="16dp"
            android:elevation="4dp">

            <ImageView
                android:id="@+id/btn_back"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_back"
                android:background="?selectableItemBackground"
                android:padding="12dp"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="User Reviews"
                android:textColor="#1d4ed8"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_centerInParent="true" />

        </RelativeLayout>

        <!-- Main Content -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Rate your experience Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@android:color/white"
                android:elevation="4dp"
                android:padding="20dp"
                android:layout_marginBottom="16dp"
                android:radius="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Rate your experience"
                    android:textColor="#333"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <!-- Star Rating -->
                <LinearLayout
                    android:id="@+id/star_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <ImageView
                        android:id="@+id/star1"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/ic_star_filled"
                        android:padding="2dp"
                        android:layout_marginEnd="4dp" />

                    <ImageView
                        android:id="@+id/star2"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/ic_star_filled"
                        android:padding="2dp"
                        android:layout_marginEnd="4dp" />

                    <ImageView
                        android:id="@+id/star3"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/ic_star_filled"
                        android:padding="2dp"
                        android:layout_marginEnd="4dp" />

                    <ImageView
                        android:id="@+id/star4"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/ic_star_filled"
                        android:padding="2dp"
                        android:layout_marginEnd="4dp" />

                    <ImageView
                        android:id="@+id/star5"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/ic_star_empty"
                        android:padding="2dp" />

                </LinearLayout>

                <!-- Review Text Area -->
                <EditText
                    android:id="@+id/review_text"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:background="#f5f5f5"
                    android:hint="Write your review here..."
                    android:padding="12dp"
                    android:textSize="14sp"
                    android:gravity="top"
                    android:layout_marginBottom="16dp"
                    android:radius="8dp" />

                <!-- Submit Button -->
                <Button
                    android:id="@+id/btn_submit_review"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Submit Review"
                    android:textColor="@android:color/white"
                    android:background="#1d4ed8"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:radius="8dp" />

            </LinearLayout>

            <!-- Reviews Summary -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <!-- Rating Info -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4.2"
                        android:textColor="#333"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:layout_marginEnd="8dp" />

                    <!-- Stars -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginEnd="8dp">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_star_filled"
                            android:layout_marginEnd="2dp" />
                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_star_filled"
                            android:layout_marginEnd="2dp" />
                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_star_filled"
                            android:layout_marginEnd="2dp" />
                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_star_filled"
                            android:layout_marginEnd="2dp" />
                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_star_empty" />

                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="(128 reviews at companies)"
                        android:textColor="#666"
                        android:textSize="12sp" />

                </LinearLayout>

<!--                &lt;!&ndash; Sort Button &ndash;&gt;-->
<!--                <Button-->
<!--                    android:id="@+id/btn_sort"-->
<!--                    android:layout_width="wrap_content"-->
<!--                    android:layout_height="wrap_content"-->
<!--                    android:text="Most Relevant"-->
<!--                    android:textColor="#1d4ed8"-->
<!--                    android:textSize="14sp"-->
<!--                    android:background="@android:color/transparent"-->
<!--                    android:drawableEnd="@drawable/ic_arrow_down" />-->

            </LinearLayout>

            <!-- Reviews List -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerViewBikeReviews"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:layout_marginBottom="16dp" />

            <!-- Empty State -->
            <TextView
                android:id="@+id/tv_no_reviews"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No reviews yet. Be the first to review!"
                android:gravity="center"
                android:padding="24dp"
                android:textSize="16sp"
                android:textColor="#888"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>