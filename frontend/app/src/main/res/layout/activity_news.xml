<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F4F6"
    android:fitsSystemWindows="true"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp"
            android:background="#F3F4F6">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:scaleType="center"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:tint="#111827" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Motorcycle News"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#111827"
                android:paddingStart="16dp" />
        </LinearLayout>

        <!-- Latest tab -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingBottom="16px"
            android:background="#F3F4F6">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Latest"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:background="@drawable/bg_primary_rounded"
                android:backgroundTint="#EA580C" />
        </LinearLayout>

        <!-- Main content -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="24dp">

            <!-- Featured News (Upcoming) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/featuredNews"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#FFFFFF"
                android:layout_marginBottom="24dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <!-- Featured Image -->
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="220dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/sample_bike"
                        android:contentDescription="Featured Upcoming Launch" />

                    <!-- UPCOMING badge -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="UPCOMING"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="4dp"
                        android:background="#EA580C"
                        android:layout_margin="12dp"
                        android:elevation="4dp" />

                    <!-- Gradient overlay and text -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/gradient_bottom"
                        android:padding="16dp"
                        android:layout_alignParentBottom="true">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="New Royal Enfield Himalayan 450 Coming Soon"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF"
                            android:lineSpacingExtra="2dp"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Launch expected next month. Check out leaked specs."
                            android:textSize="12sp"
                            android:textColor="#E5E7EB"
                            android:maxLines="1"
                            android:ellipsize="end" />
                    </LinearLayout>
                </RelativeLayout>
            </androidx.cardview.widget.CardView>



            <!-- Upcoming Launches Title -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Upcoming Launches"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#111827"
                android:layout_marginBottom="16px" />

            <!-- News Item 1 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/news1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <!-- News Image -->
                    <ImageView
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_electricals"
                        android:contentDescription="EV News"
                        android:background="#E5E7EB"
                        android:padding="2dp" />

                    <!-- News Content -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="12dp"
                        android:paddingTop="4dp">

                        <!-- Category -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="UPCOMING"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="#2563EB"
                            android:letterSpacing="0.05"
                            android:layout_marginBottom="4dp" />

                        <!-- Title -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="TVS Apache RTR 310 Launch Date"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#111827"
                            android:maxLines="2"
                            android:ellipsize="end"
                            android:lineSpacingExtra="2dp" />

                        <!-- Description -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Expected to arrive next week with new features..."
                            android:textSize="12sp"
                            android:textColor="#4B5563"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:layout_marginTop="4dp" />


                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- News Item 2 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/news2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_commuter"
                        android:contentDescription="Helmet Review"
                        android:background="#E5E7EB"
                        android:padding="2dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="12dp"
                        android:paddingTop="4dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="UPCOMING"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="#16A34A"
                            android:letterSpacing="0.05"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Honda's New Electric Scooter Teased"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#111827"
                            android:maxLines="2"
                            android:ellipsize="end"
                            android:lineSpacingExtra="2dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Set to rival the Activa electric."
                            android:textSize="12sp"
                            android:textColor="#4B5563"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:layout_marginTop="4dp" />


                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Maintenance Tips Title -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Maintenance Tips"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#111827"
                android:layout_marginBottom="16px"
                android:layout_marginTop="16px" />

            <!-- News Item 3 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/news3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_power"
                        android:contentDescription="MotoGP"
                        android:background="#E5E7EB"
                        android:padding="2dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="12dp"
                        android:paddingTop="4dp">

                        <!-- Maintenance Tips Title Inserted Above news3 technically, but doing it here inside content is easier to just change content -->
                        <!-- Wait, I should insert the Header TextView BEFORE news3 in the parent linear layout. But multi_replace operates on blocks. -->
                        <!-- I will just change this item to Maintenance Tip 1 -->

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="MAINTENANCE"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="#EA580C"
                            android:letterSpacing="0.05"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="How to Lube Your Chain Correctly"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#111827"
                            android:maxLines="2"
                            android:ellipsize="end"
                            android:lineSpacingExtra="2dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Extend chain life with these simple steps."
                            android:textSize="12sp"
                            android:textColor="#4B5563"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:layout_marginTop="4dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="2 days ago"
                            android:textSize="10sp"
                            android:textColor="#4B5563"
                            android:layout_marginTop="8dp" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- News Item 4 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/news4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_displacement"
                        android:contentDescription="Maintenance"
                        android:background="#E5E7EB"
                        android:padding="2dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="12dp"
                        android:paddingTop="4dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="MAINTENANCE"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="#EA580C"
                            android:letterSpacing="0.05"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Correct Tire Pressure: Why It Matters"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#111827"
                            android:maxLines="2"
                            android:ellipsize="end"
                            android:lineSpacingExtra="2dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Save fuel and improve handling with proper inflation."
                            android:textSize="12sp"
                            android:textColor="#4B5563"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:layout_marginTop="4dp" />


                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </LinearLayout>
</ScrollView>