<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F4F6"
    android:fitsSystemWindows="true"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp"
            android:background="#F3F4F6">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:scaleType="center"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:tint="#111827" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Motorcycle News"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#111827"
                android:paddingStart="16dp" />
        </LinearLayout>

        <!-- Latest tab -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingBottom="16px"
            android:background="#F3F4F6">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Latest"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:background="@drawable/bg_primary_rounded"
                android:backgroundTint="#EA580C" />
        </LinearLayout>

        <!-- Main content -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="24dp">

            <!-- Upcoming Bikes Slider -->
            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/vpUpcomingBikes"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginBottom="24dp"
                android:clipToPadding="false"
                android:clipChildren="false"/>

            <!-- Upcoming Launches Title -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Upcoming Launches"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#111827"
                android:layout_marginBottom="16px" />

            <!-- News Item 1 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/news1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <!-- News Image -->
                    <ImageView
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_electricals"
                        android:contentDescription="EV News"
                        android:background="#E5E7EB"
                        android:padding="2dp" />

                    <!-- News Content -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="12dp"
                        android:paddingTop="4dp">

                        <!-- Category -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="UPCOMING"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="#2563EB"
                            android:letterSpacing="0.05"
                            android:layout_marginBottom="4dp" />

                        <!-- Title -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="TVS Apache RTR 310 Launch Date"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#111827"
                            android:maxLines="2"
                            android:ellipsize="end"
                            android:lineSpacingExtra="2dp" />

                        <!-- Description -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Expected to arrive next week with new features..."
                            android:textSize="12sp"
                            android:textColor="#4B5563"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:layout_marginTop="4dp" />

                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- News Item 2 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/news2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_commuter"
                        android:contentDescription="Helmet Review"
                        android:background="#E5E7EB"
                        android:padding="2dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="12dp"
                        android:paddingTop="4dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="UPCOMING"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="#16A34A"
                            android:letterSpacing="0.05"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Honda's New Electric Scooter Teased"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#111827"
                            android:maxLines="2"
                            android:ellipsize="end"
                            android:lineSpacingExtra="2dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Set to rival the Activa electric."
                            android:textSize="12sp"
                            android:textColor="#4B5563"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:layout_marginTop="4dp" />

                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Maintenance Tips Title -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Maintenance Tips"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#111827"
                android:layout_marginBottom="16px"
                android:layout_marginTop="16px" />

            <!-- Maintenance Guide Button -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnBikeMaintenance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Bikes Maintenance Guide"
                app:backgroundTint="#EA580C"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="12dp"
                android:padding="12dp"
                android:textStyle="bold"
                android:stateListAnimator="@null" />

            <!-- News Item 4 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/news4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_displacement"
                        android:contentDescription="Maintenance"
                        android:background="#E5E7EB"
                        android:padding="2dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="12dp"
                        android:paddingTop="4dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="MAINTENANCE"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="#EA580C"
                            android:letterSpacing="0.05"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Correct Tire Pressure: Why It Matters"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#111827"
                            android:maxLines="2"
                            android:ellipsize="end"
                            android:lineSpacingExtra="2dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Save fuel and improve handling with proper inflation."
                            android:textSize="12sp"
                            android:textColor="#4B5563"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:layout_marginTop="4dp" />

                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </LinearLayout>
</ScrollView>