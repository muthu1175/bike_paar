<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F4F4"
    android:fitsSystemWindows="true">

    <!-- TOP BAR -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@android:color/white">

        <ImageView
            android:id="@+id/ivMenu"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="16dp"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_menu" />

        <ImageView
            android:id="@+id/ivLogo"
            android:layout_width="520dp"
            android:layout_height="324dp"
            android:layout_centerInParent="true"
            android:src="@drawable/bikepaar_logo" />

        <ImageView
            android:id="@+id/ivBell"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginEnd="16dp"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            android:src="@drawable/ic_notifications" />
    </RelativeLayout>

    <!-- BLUE CARD -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="66dp"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingTop="14dp"
        android:paddingBottom="20dp"
        android:background="@drawable/ai_card_bg">

        <!-- header: label + progress + close -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/tvAiLabel_q4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AI Suggestion"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="14sp"
                android:layout_alignParentStart="true"/>

            <ProgressBar
                android:id="@+id/progressBar_card_q4"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_below="@id/tvAiLabel_q4"
                android:layout_marginTop="8dp"
                android:indeterminate="false"
                android:max="9"
                android:progress="4"
                android:progressTint="#27AE60"
                android:backgroundTint="#2B3A6A"/>

            <TextView
                android:id="@+id/tvStep_card_q4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4/9"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:layout_alignParentEnd="true"
                android:layout_alignBaseline="@id/tvAiLabel_q4"
                android:layout_marginEnd="36dp"/>

            <ImageView
                android:id="@+id/btnClose_card_q4"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:tint="#FFFFFF"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="2dp"/>
        </RelativeLayout>

        <!-- big icon -->
        <ImageView
            android:id="@+id/ic_primary_big_q4"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_marginTop="6dp"
            android:layout_gravity="center_horizontal"
            android:src="@drawable/ic_primary_big" />

        <!-- title/subtitle -->
        <TextView
            android:id="@+id/tvTitle_q4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Primary usage?"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginTop="16dp"
            android:layout_gravity="center_horizontal"/>

        <TextView
            android:id="@+id/tvSub_q4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="select the bike need to ride with"
            android:textSize="12sp"
            android:textColor="#BFE0FF"
            android:layout_marginTop="6dp"
            android:layout_gravity="center_horizontal"/>

        <!-- options -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="18dp">

            <!-- Daily use -->
            <RelativeLayout
                android:id="@+id/optDaily_q4"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:padding="12dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/option_bg">

                <ImageView
                    android:id="@+id/ivDaily_q4"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:src="@drawable/ic_daily"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"/>

                <TextView
                    android:id="@+id/tvDailyTitle_q4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Daily use"
                    android:textColor="#222222"
                    android:textStyle="bold"
                    android:layout_toEndOf="@id/ivDaily_q4"
                    android:layout_marginStart="12dp"
                    android:layout_alignTop="@id/ivDaily_q4"/>

                <TextView
                    android:id="@+id/tvDailySub_q4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="city and work"
                    android:textColor="#666666"
                    android:layout_toEndOf="@id/ivDaily_q4"
                    android:layout_marginStart="12dp"
                    android:layout_below="@id/tvDailyTitle_q4"
                    android:layout_marginTop="6dp"/>

                <ImageView
                    android:id="@+id/ivDailyTick_q4"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_radio_unselected"
                    android:visibility="invisible" />
            </RelativeLayout>

            <!-- Adventure -->
            <RelativeLayout
                android:id="@+id/optAdventure_q4"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:padding="12dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/option_bg">

                <ImageView
                    android:id="@+id/ivAdventure_q4"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:src="@drawable/ic_adventure"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"/>

                <TextView
                    android:id="@+id/tvAdventureTitle_q4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Adventure"
                    android:textColor="#222222"
                    android:textStyle="bold"
                    android:layout_toEndOf="@id/ivAdventure_q4"
                    android:layout_marginStart="12dp"
                    android:layout_alignTop="@id/ivAdventure_q4"/>

                <TextView
                    android:id="@+id/tvAdventureSub_q4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="rough and long"
                    android:textColor="#666666"
                    android:layout_toEndOf="@id/ivAdventure_q4"
                    android:layout_marginStart="12dp"
                    android:layout_below="@id/tvAdventureTitle_q4"
                    android:layout_marginTop="6dp"/>

                <ImageView
                    android:id="@+id/ivAdventureTick_q4"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_radio_unselected"
                    android:visibility="invisible" />
            </RelativeLayout>

            <!-- Sports -->
            <RelativeLayout
                android:id="@+id/optSports_q4"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:padding="12dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/option_bg">

                <ImageView
                    android:id="@+id/ivSports_q4"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:src="@drawable/ic_sports"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"/>

                <TextView
                    android:id="@+id/tvSportsTitle_q4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sports"
                    android:textColor="#222222"
                    android:textStyle="bold"
                    android:layout_toEndOf="@id/ivSports_q4"
                    android:layout_marginStart="12dp"
                    android:layout_alignTop="@id/ivSports_q4"/>

                <TextView
                    android:id="@+id/tvSportsSub_q4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Performance"
                    android:textColor="#666666"
                    android:layout_toEndOf="@id/ivSports_q4"
                    android:layout_marginStart="12dp"
                    android:layout_below="@id/tvSportsTitle_q4"
                    android:layout_marginTop="6dp"/>

                <ImageView
                    android:id="@+id/ivSportsTick_q4"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_radio_unselected"
                    android:visibility="invisible" />
            </RelativeLayout>
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>

        <!-- navigation -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <TextView
                android:id="@+id/btnBack_q4"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:gravity="center"
                android:text="back"
                android:textColor="#FFFFFF"
                android:background="@drawable/ai_prev_button_bg"/>

            <TextView
                android:id="@+id/btnNext_q4"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:gravity="center"
                android:text="next  →"
                android:textColor="#FFFFFF"
                android:background="@drawable/ai_next_button_bg"/>
        </LinearLayout>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
