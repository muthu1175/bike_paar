<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF5F5">

    <!-- Top App Bar -->
    <RelativeLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:background="#FAF5F5"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            android:src="@drawable/ic_back_arrow"
            app:tint="#A03020" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_toRightOf="@id/ivBack"
            android:layout_marginLeft="16dp"
            android:layout_centerVertical="true"
            android:gravity="center_vertical">
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Add New\nBike"
                android:textColor="#A03020"
                android:textSize="18sp"
                android:textStyle="bold"
                android:lineSpacingExtra="-4dp"/>

        </LinearLayout>

        <Button
            android:id="@+id/btnViewDrafts"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            android:text="Drafts"
            android:textSize="12sp"
            android:textAllCaps="false"
            android:backgroundTint="#F2ECEC"
            android:textColor="#A03020"
            app:cornerRadius="8dp"/>
    </RelativeLayout>

    <View
        android:id="@+id/dividerTop"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#EAEAEA"
        android:layout_below="@id/topBar"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/dividerTop"
        android:layout_above="@id/bottomBar"
        android:clipToPadding="false"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Upload Photo Box -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cvImageUpload"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#FFFFFF"
                android:layout_marginBottom="24dp">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="24dp"
                    android:background="@drawable/dashed_border">
                    
                    <ImageView
                        android:id="@+id/ivSelectedImage"
                        android:layout_width="120dp"
                        android:layout_height="80dp"
                        android:src="@drawable/ic_camera_alt"
                        android:scaleType="centerInside"
                        app:tint="#A03020"
                        android:background="@drawable/circle_bg_light_red"
                        android:padding="12dp"
                        android:layout_marginBottom="12dp"/>
                        
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Upload Bike Photos"
                        android:textColor="#333333"
                        android:textSize="14sp"
                        android:textStyle="bold"/>
                        
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Supports high-res JPG, PNG\n(Max 10MB per image)"
                        android:textColor="#888888"
                        android:textSize="12sp"
                        android:gravity="center"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="16dp"/>
                        
                    <Button
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="Select Files"
                        android:textAllCaps="false"
                        android:backgroundTint="#006A71"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        app:cornerRadius="8dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Basic Information Section -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#FFFFFF"
                android:layout_marginBottom="16dp">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Basic Information"
                        android:textColor="#333333"
                        android:textSize="14sp"
                        android:layout_marginBottom="16dp"/>
                        
                    <!-- Bike Name -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bike Name"
                        android:textSize="12sp"
                        android:textColor="#333333"
                        android:layout_marginBottom="4dp"/>
                    <EditText
                        android:id="@+id/etBikeName"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/rounded_edittext_border"
                        android:hint="e.g. Ducati Panigale V4"
                        android:paddingHorizontal="12dp"
                        android:textSize="14sp"
                        android:layout_marginBottom="16dp"/>
                        
                    <!-- Brand -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Brand"
                        android:textSize="12sp"
                        android:textColor="#333333"
                        android:layout_marginBottom="4dp"/>
                    <EditText
                        android:id="@+id/etBrand"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/rounded_edittext_border"
                        android:hint="e.g. Ducati"
                        android:paddingHorizontal="12dp"
                        android:textSize="14sp"
                        android:layout_marginBottom="16dp"/>
                    
                    <!-- Price -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Price (₹)"
                        android:textSize="12sp"
                        android:textColor="#333333"
                        android:layout_marginBottom="4dp"/>
                    <EditText
                        android:id="@+id/etPrice"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/rounded_edittext_border"
                        android:hint="0.00"
                        android:inputType="numberDecimal"
                        android:paddingHorizontal="12dp"
                        android:textSize="14sp"
                        android:layout_marginBottom="16dp"/>
                        
                    <!-- Listing Status -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Listing Status"
                        android:textSize="12sp"
                        android:textColor="#333333"
                        android:layout_marginBottom="8dp"/>
                    
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/rounded_toggle_selected"
                            android:backgroundTint="#00C8F8"
                            android:paddingHorizontal="20dp"
                            android:paddingVertical="10dp"
                            android:gravity="center"
                            android:layout_marginRight="12dp">
                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:src="@drawable/ic_check_circle"
                                app:tint="#005A8C"
                                android:layout_marginRight="6dp"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Active"
                                android:textColor="#005A8C"
                                android:textSize="14sp"
                                android:textStyle="bold"/>
                        </LinearLayout>
                        
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Inactive"
                            android:textColor="#A03020"
                            android:textSize="14sp"
                            android:paddingHorizontal="24dp"
                            android:paddingVertical="10dp"
                            android:background="@drawable/rounded_toggle_selected"
                            android:backgroundTint="#F5E0D8"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>


            <!-- Technical Specifications Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#FFFFFF"
                android:layout_marginBottom="16dp">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">
                    
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Complete Technical\nSpecifications"
                        android:textColor="#A03020"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="16dp"/>

                    <!-- PERFORMANCE -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⏱️ PERFORMANCE"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="#333333"
                        android:layout_marginBottom="12dp"/>

                    <include layout="@layout/include_spec_field" android:id="@+id/fldEngine" android:layout_width="match_parent" android:layout_height="wrap_content" />
                    <include layout="@layout/include_spec_field" android:id="@+id/fldPower" android:layout_width="match_parent" android:layout_height="wrap_content" />
                    <include layout="@layout/include_spec_field" android:id="@+id/fldTorque" android:layout_width="match_parent" android:layout_height="wrap_content" />
                    <include layout="@layout/include_spec_field" android:id="@+id/fldTopSpeed" android:layout_width="match_parent" android:layout_height="wrap_content" />
                    <include layout="@layout/include_spec_field" android:id="@+id/fldMileage" android:layout_width="match_parent" android:layout_height="wrap_content" />
                    <include layout="@layout/include_spec_field" android:id="@+id/fldTransmission" android:layout_width="match_parent" android:layout_height="wrap_content" />

                    <!-- HARDWARE -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚙️ HARDWARE"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="#333333"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="12dp"/>

                    <include layout="@layout/include_spec_field" android:id="@+id/fldBrakingSystem" android:layout_width="match_parent" android:layout_height="wrap_content" />
                    <include layout="@layout/include_spec_field" android:id="@+id/fldFrontBrake" android:layout_width="match_parent" android:layout_height="wrap_content" />
                    <include layout="@layout/include_spec_field" android:id="@+id/fldRearBrake" android:layout_width="match_parent" android:layout_height="wrap_content" />
                    <include layout="@layout/include_spec_field" android:id="@+id/fldFrontSuspension" android:layout_width="match_parent" android:layout_height="wrap_content" />
                    <include layout="@layout/include_spec_field" android:id="@+id/fldRearSuspension" android:layout_width="match_parent" android:layout_height="wrap_content" />
                    <include layout="@layout/include_spec_field" android:id="@+id/fldTyreType" android:layout_width="match_parent" android:layout_height="wrap_content" />
                    <include layout="@layout/include_spec_field" android:id="@+id/fldInstrumentCluster" android:layout_width="match_parent" android:layout_height="wrap_content" />
                    <include layout="@layout/include_spec_field" android:id="@+id/fldHeadlight" android:layout_width="match_parent" android:layout_height="wrap_content" />
                    <include layout="@layout/include_spec_field" android:id="@+id/fldTailLight" android:layout_width="match_parent" android:layout_height="wrap_content" />
                    <include layout="@layout/include_spec_field" android:id="@+id/fldBatteryCapacity" android:layout_width="match_parent" android:layout_height="wrap_content" />

                    <!-- DIMENSIONS -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📏 DIMENSIONS"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="#333333"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="12dp"/>

                    <include layout="@layout/include_spec_field" android:id="@+id/fldOverallLength" android:layout_width="match_parent" android:layout_height="wrap_content" />
                    <include layout="@layout/include_spec_field" android:id="@+id/fldOverallWidth" android:layout_width="match_parent" android:layout_height="wrap_content" />
                    <include layout="@layout/include_spec_field" android:id="@+id/fldWeight" android:layout_width="match_parent" android:layout_height="wrap_content" />
                    <include layout="@layout/include_spec_field" android:id="@+id/fldFuelTank" android:layout_width="match_parent" android:layout_height="wrap_content" />
                    <include layout="@layout/include_spec_field" android:id="@+id/fldSeatHeight" android:layout_width="match_parent" android:layout_height="wrap_content" />
                    <include layout="@layout/include_spec_field" android:id="@+id/fldClearance" android:layout_width="match_parent" android:layout_height="wrap_content" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Insights Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#FFFFFF"
                android:layout_marginBottom="16dp">
                
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">
                    
                    <ImageView
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"
                        android:src="@drawable/ic_check_circle"
                        app:tint="#10000000"
                        android:scaleX="2.0"
                        android:scaleY="2.0"/>
                        
                    <TextView
                        android:id="@+id/tvInsightsTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Listing Performance Insights"
                        android:textColor="#333333"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp"/>
                        
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/tvInsightsTitle"
                        android:text="Detailed technical listings get 45% more engagement from potential buyers. Ensure all performance metrics are verified."
                        android:textColor="#555555"
                        android:textSize="12sp"
                        android:lineSpacingExtra="2dp"
                        android:layout_marginRight="40dp"/>
                </RelativeLayout>
            </androidx.cardview.widget.CardView>

            <!-- PRO TIP Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#FF6600">
                
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">
                    
                    <TextView
                        android:id="@+id/tvProTipTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PRO TIP"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp"/>
                        
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/tvProTipTitle"
                        android:text="Use high-contrast shots of the engine and cluster for maximum appeal."
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:layout_marginRight="40dp"/>
                        
                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_alignParentRight="true"
                        android:layout_alignParentBottom="true"
                        android:src="@drawable/ic_lightbulb"
                        app:tint="#000000" />
                </RelativeLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Action Bar -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#FAF5F5"
        android:orientation="horizontal"
        android:padding="16dp"
        android:weightSum="3">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/rounded_button"
            android:backgroundTint="#006A71"
            android:gravity="center"
            android:layout_marginRight="8dp">
            
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_save"
                app:tint="#FFFFFF"
                android:layout_marginRight="4dp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Save\nDraft"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center_horizontal"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="2"
            android:background="@drawable/rounded_button"
            android:backgroundTint="#A03010"
            android:gravity="center">
            
            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_upload"
                app:tint="#FFFFFF"
                android:layout_marginRight="8dp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PUBLISH\nTO DATABASE"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center_horizontal"/>
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>
