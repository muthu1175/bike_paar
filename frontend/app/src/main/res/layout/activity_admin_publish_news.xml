<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF5F5">

    <!-- Custom Top Bar -->
    <RelativeLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_arrow_back"
            app:tint="#A03010" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:layout_marginLeft="16dp"
            android:text="Publish News"
            android:textColor="#A03010"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_more_vert"
            app:tint="#A03010" />
    </RelativeLayout>

    <View
        android:id="@+id/dividerTop"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#EAEAEA"
        app:layout_constraintTop_toBottomOf="@id/topBar"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/dividerTop"
        app:layout_constraintBottom_toTopOf="@id/bottomBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Upload Image -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="UPLOAD NEWS IMAGE"
                android:textColor="#604030"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:id="@+id/llImageUpload"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:background="@drawable/dashed_border"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginBottom="24dp">
                
                <ImageView
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:src="@drawable/ic_camera_alt"
                    android:background="@drawable/circle_background"
                    android:backgroundTint="#FFFFFF"
                    android:padding="12dp"
                    app:tint="#A03010"
                    android:layout_marginBottom="12dp"/>
                    
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tap to select photo"
                    android:textColor="#402010"
                    android:textSize="14sp"
                    android:textStyle="bold"/>
                    
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="JPG, PNG up to 10 MB"
                    android:textColor="#A08070"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <!-- News Headline -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NEWS HEADLINE"
                android:textColor="#604030"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/etNewsHeadline"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/rounded_edittext"
                android:hint="Enter a catchy headline..."
                android:paddingHorizontal="16dp"
                android:textColor="#202020"
                android:textColorHint="#B0B0B0"
                android:layout_marginBottom="24dp"/>

            <!-- News Body -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NEWS BODY/DESCRIPTION"
                android:textColor="#604030"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="250dp"
                android:orientation="vertical"
                android:background="@drawable/rounded_edittext"
                android:layout_marginBottom="24dp">
                
                <!-- Toolbar Mock -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:orientation="horizontal"
                    android:background="#FAF0E8"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp">
                    
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="B" android:textColor="#402010" android:textStyle="bold" android:textSize="16sp" android:layout_marginRight="16dp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="I" android:textColor="#402010" android:textStyle="bold|italic" android:textSize="16sp" android:layout_marginRight="16dp"/>
                    <View android:layout_width="1dp" android:layout_height="20dp" android:background="#D0B0A0" android:layout_marginRight="16dp"/>
                    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_list" app:tint="#402010" android:layout_marginRight="16dp"/>
                    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_link" app:tint="#402010"/>
                </LinearLayout>
                
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EAEAEA"/>
                
                <!-- Text Area -->
                <EditText
                    android:id="@+id/etNewsBody"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:hint="Write the full article details here..."
                    android:padding="16dp"
                    android:gravity="top|left"
                    android:textColor="#202020"
                    android:textColorHint="#B0B0B0"/>
            </LinearLayout>

            <!-- Pin to top Toggle -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardUseCompatPadding="true">
                
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">
                    
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_centerVertical="true">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Pin to top" android:textColor="#202020" android:textSize="16sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Show at the top of the news feed" android:textColor="#806050" android:textSize="12sp"/>
                    </LinearLayout>
                    
                    <Switch
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"/>
                </RelativeLayout>
            </androidx.cardview.widget.CardView>

            <!-- Category & Visibility Dropdowns Mock -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false"
                android:layout_marginBottom="40dp">
                
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginRight="8dp">
                    
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="#FFFFFF"
                        app:cardUseCompatPadding="true">
                        
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="16dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CATEGORY" android:textColor="#806050" android:textSize="10sp" android:textStyle="bold"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Updates" android:textColor="#202020" android:textSize="16sp" android:textStyle="bold"/>
                            <ImageView android:layout_width="16dp" android:layout_height="16dp" android:layout_alignParentRight="true" android:layout_marginTop="20dp" android:src="@drawable/ic_arrow_drop_down" app:tint="#604030"/>
                        </RelativeLayout>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginLeft="8dp">
                    
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="#FFFFFF"
                        app:cardUseCompatPadding="true">
                        
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="16dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="VISIBILITY" android:textColor="#806050" android:textSize="10sp" android:textStyle="bold"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Public" android:textColor="#202020" android:textSize="16sp" android:textStyle="bold"/>
                            <ImageView android:layout_width="16dp" android:layout_height="16dp" android:layout_alignParentRight="true" android:layout_marginTop="20dp" android:src="@drawable/ic_arrow_drop_down" app:tint="#604030"/>
                        </RelativeLayout>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Action Bar -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FAF5F5"
        android:padding="16dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent">

        <Button
            android:id="@+id/btnSaveDraft"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="SAVE DRAFT"
            android:textColor="#A03010"
            android:textSize="14sp"
            android:textStyle="bold"
            app:strokeColor="#A03010"
            app:strokeWidth="1dp"
            app:cornerRadius="12dp"
            android:layout_marginRight="8dp"/>
            
        <Button
            android:id="@+id/btnPublishArticle"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:backgroundTint="#FF6600"
            android:text="PUBLISH ARTICLE"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            android:layout_marginLeft="8dp"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
