<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF5F5">

    <!-- Custom Top Bar -->
    <RelativeLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_arrow_back"
            app:tint="#A03010" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Send Notification"
            android:textColor="#A03010"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_more_vert"
            app:tint="#A03010" />
    </RelativeLayout>

    <View
        android:id="@+id/dividerTop"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#EAEAEA"
        app:layout_constraintTop_toBottomOf="@id/topBar"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/dividerTop"
        app:layout_constraintBottom_toTopOf="@id/bottomBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Push Notification"
                android:textColor="#202020"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Broadcast urgent updates and marketing offers to your motorcycle community instantly."
                android:textColor="#606060"
                android:textSize="14sp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp"/>

            <!-- Notification Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NOTIFICATION TITLE"
                android:textColor="#503020"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/etNotificationTitle"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/rounded_edittext"
                android:hint="e.g., Mega Offer!"
                android:paddingHorizontal="16dp"
                android:textColor="#202020"
                android:textColorHint="#A0A0A0"
                android:layout_marginBottom="20dp"/>

            <!-- Notification Message -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NOTIFICATION MESSAGE"
                android:textColor="#503020"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/etNotificationMessage"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:background="@drawable/rounded_edittext"
                android:hint="e.g., Prices dropped for Yamaha R15.\nCheck it out now!"
                android:padding="16dp"
                android:gravity="top|left"
                android:textColor="#202020"
                android:textColorHint="#A0A0A0"
                android:layout_marginBottom="24dp"/>

            <!-- Target Audience -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TARGET AUDIENCE"
                android:textColor="#503020"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:background="@drawable/rounded_toggle_bg"
                android:layout_marginBottom="32dp">
                
                <TextView
                    android:id="@+id/btnAudienceAll"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="All Users"
                    android:gravity="center"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:background="@drawable/rounded_toggle_selected"/>
                    
                <TextView
                    android:id="@+id/btnAudienceActive"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="Active Users"
                    android:gravity="center"
                    android:textColor="#604030"
                    android:textStyle="bold"/>
            </LinearLayout>

            <!-- Live Preview Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardUseCompatPadding="true">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp">
                    
                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_notifications"
                        android:background="@drawable/circle_background"
                        android:backgroundTint="#F0E0D8"
                        android:padding="8dp"
                        app:tint="#A03010"
                        android:layout_marginRight="16dp"/>
                        
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Live Preview"
                            android:textColor="#604030"
                            android:textSize="12sp"
                            android:textStyle="bold"/>
                            
                        <TextView
                            android:id="@+id/tvPreviewTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sample Notification"
                            android:textColor="#202020"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:layout_marginTop="2dp"/>
                            
                        <TextView
                            android:id="@+id/tvPreviewMessage"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Users will receive this alert as a push message on their mobile lock screen."
                            android:textColor="#606060"
                            android:textSize="13sp"
                            android:textStyle="italic"
                            android:layout_marginTop="4dp"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            
            <!-- Extra space to scroll past keyboard -->
            <View android:layout_width="match_parent" android:layout_height="40dp"/>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Action Bar -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FAF5F5"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <Button
            android:id="@+id/btnSendNow"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:backgroundTint="#FF6600"
            android:text="Send Now"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="12dp"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
