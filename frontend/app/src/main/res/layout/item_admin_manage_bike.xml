<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardUseCompatPadding="true">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <ImageView
            android:id="@+id/ivBikeImage"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_centerVertical="true"
            android:scaleType="centerInside"
            android:background="#FAF5F5"
            android:padding="4dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_toRightOf="@id/ivBikeImage"
            android:layout_toLeftOf="@id/actionArea"
            android:layout_marginLeft="16dp"
            android:layout_centerVertical="true">

            <TextView 
                android:id="@+id/tvBikeName"
                android:layout_width="wrap_content" 
                android:layout_height="wrap_content" 
                android:text="Bike Name" 
                android:textColor="#202020" 
                android:textSize="16sp" 
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"/>
                
            <TextView 
                android:id="@+id/tvBikeBrand"
                android:layout_width="wrap_content" 
                android:layout_height="wrap_content" 
                android:text="Brand" 
                android:textColor="#666666" 
                android:textSize="12sp" 
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:ellipsize="end"/>

            <TextView 
                android:id="@+id/tvBikePrice"
                android:layout_width="wrap_content" 
                android:layout_height="wrap_content" 
                android:text="₹ 0" 
                android:textColor="#A03010" 
                android:textSize="14sp" 
                android:textStyle="bold" 
                android:layout_marginTop="8dp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/actionArea"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true">
            
            <ImageView 
                android:id="@+id/btnEdit" 
                android:layout_width="32dp" 
                android:layout_height="32dp" 
                android:src="@drawable/ic_edit" 
                android:padding="4dp"
                app:tint="#604030" 
                android:layout_marginBottom="16dp"/>
                
            <ImageView 
                android:id="@+id/btnDelete" 
                android:layout_width="32dp" 
                android:layout_height="32dp" 
                android:src="@drawable/ic_delete" 
                android:padding="4dp"
                app:tint="#D01010"/>
        </LinearLayout>
    </RelativeLayout>
</androidx.cardview.widget.CardView>
