<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardUseCompatPadding="true">
    
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">
        
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">
            
            <ImageView
                android:id="@+id/ivAvatar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_person"
                android:background="@drawable/circle_background"
                android:backgroundTint="#D0E0E8"
                android:padding="4dp"
                app:tint="#103040"
                android:layout_centerVertical="true"/>
                
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_toRightOf="@id/ivAvatar"
                android:layout_marginLeft="12dp"
                android:layout_centerVertical="true">
                <TextView 
                    android:id="@+id/tvUserName"
                    android:layout_width="wrap_content" 
                    android:layout_height="wrap_content" 
                    android:text="User Name" 
                    android:textColor="#202020" 
                    android:textSize="16sp" 
                    android:textStyle="bold"/>
                <TextView 
                    android:id="@+id/tvDate"
                    android:layout_width="wrap_content" 
                    android:layout_height="wrap_content" 
                    android:text="Date" 
                    android:textColor="#606060" 
                    android:textSize="12sp" 
                    android:textStyle="bold"/>
            </LinearLayout>
            
            <TextView
                android:id="@+id/tvBikeModel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🏍️ Bike Model"
                android:textColor="#104060"
                android:textSize="10sp"
                android:textStyle="bold"
                android:background="@drawable/rounded_toggle_bg"
                android:backgroundTint="#F0E8E4"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"/>
        </RelativeLayout>
        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/rounded_edittext"
            android:backgroundTint="#FFF5F5"
            android:padding="16dp"
            android:layout_marginBottom="16dp">
            
            <LinearLayout 
                android:layout_width="wrap_content" 
                android:layout_height="wrap_content" 
                android:orientation="horizontal" 
                android:gravity="center_vertical" 
                android:layout_marginBottom="8dp">
                <ImageView 
                    android:layout_width="16dp" 
                    android:layout_height="16dp" 
                    android:src="@drawable/ic_star" 
                    app:tint="#C01010" 
                    android:layout_marginRight="8dp"/>
                <TextView 
                    android:id="@+id/tvRating"
                    android:layout_width="wrap_content" 
                    android:layout_height="wrap_content" 
                    android:text="5 STAR REVIEW" 
                    android:textColor="#C01010" 
                    android:textSize="10sp" 
                    android:textStyle="bold"/>
            </LinearLayout>
            
            <TextView
                android:id="@+id/tvReview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Review text goes here..."
                android:textColor="#404040"
                android:textSize="14sp"
                android:textStyle="italic"
                android:lineSpacingExtra="4dp"/>
        </LinearLayout>
        
    </LinearLayout>
</androidx.cardview.widget.CardView>
